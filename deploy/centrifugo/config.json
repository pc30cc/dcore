{
  "log": { "level": "info" },
  "http_server": {
    "port": 8000,
    "internal_port": "9000"
  },
  "client": {
    "allowed_origins": ["@ALLOWED_ORIGINS@"],
    "ping_interval": "25s",
    "channel_limit": 8,
    "user_connection_limit": 4,
    "allow_anonymous_connect_without_token": false,
    "disallow_anonymous_connection_tokens": true,
    "token": { "hmac_secret_key": "@TOKEN_HMAC_SECRET@" }
  },
  "http_api": { "key": "@API_KEY@" },
  "engine": {
    "type": "redis",
    "redis": { "address": "@ENGINE_REDIS_ADDRESS@" }
  },
  "channel": {
    "history_meta_ttl": "168h",
    "without_namespace": {
      "presence": false,
      "history_size": 0,
      "allow_subscribe_for_client": false,
      "allow_subscribe_for_anonymous": false,
      "allow_publish_for_client": false,
      "allow_publish_for_subscriber": false,
      "allow_publish_for_anonymous": false,
      "allow_presence_for_client": false,
      "allow_presence_for_subscriber": false,
      "allow_presence_for_anonymous": false,
      "allow_history_for_client": false,
      "allow_history_for_subscriber": false,
      "allow_history_for_anonymous": false
    },
    "namespaces": [
      {
        "name": "u",
        "allow_user_limited_channels": true,
        "presence": true,
        "join_leave": false,
        "force_push_join_leave": false,
        "history_size": 100,
        "history_ttl": "900s",
        "force_recovery": true,
        "allow_subscribe_for_client": false,
        "allow_subscribe_for_anonymous": false,
        "allow_publish_for_client": false,
        "allow_publish_for_subscriber": false,
        "allow_publish_for_anonymous": false,
        "allow_presence_for_client": false,
        "allow_presence_for_subscriber": false,
        "allow_presence_for_anonymous": false,
        "allow_history_for_client": false,
        "allow_history_for_subscriber": false,
        "allow_history_for_anonymous": false
      }
    ]
  },
  "health": { "enabled": true },
  "prometheus": { "enabled": true },
  "admin": { "enabled": false }
}
