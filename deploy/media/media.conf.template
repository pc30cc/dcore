# Rendered by media-runtime.sh into /tmp/runtime/media.conf.
upstream media_store {
    server @ORIGIN@;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location @missing {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    # The signed origins document the worker publishes: public by design (it
    # carries its own Ed25519 signature, and apps read it before they know
    # any host), so no link signature. This one key only.
    location = /bootstrap/origins.json {
        limit_except GET HEAD {
            deny all;
        }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host "@ORIGIN@";
        proxy_set_header Referer "@ORIGIN_SECRET@";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        # As below: with a variable in it, the query string is not passed on.
        proxy_pass http://media_store/@BUCKET@$uri;

        proxy_intercept_errors on;
        error_page 400 403 404 = @missing;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-minio-deployment-id;
        proxy_hide_header Server;
        proxy_ignore_headers Set-Cookie;

        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        limit_except GET HEAD {
            deny all;
        }
        if ($media_ok != "1") {
            return 403;
        }

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host "@ORIGIN@";
        proxy_set_header Referer "@ORIGIN_SECRET@";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        # The signed query string stays here; the store sees the object key only.
        proxy_pass http://media_store/@BUCKET@$uri;

        proxy_intercept_errors on;
        error_page 400 403 404 = @missing;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-minio-deployment-id;
        proxy_hide_header Server;
        proxy_ignore_headers Set-Cookie;

        # A variant never changes under its key; the link itself expires.
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
