# Variables of deploy/coolify/docker-compose.yml. In Coolify they are set on
# the resource's Environment Variables page; this file only lists them. Never
# put real values in a file in the repository.
#
# Three kinds:
#   generated  SERVICE_* magic variables: Coolify creates them on the first
#              deploy and keeps them; copy the marked ones somewhere safe
#   required   the deploy stops until they are set
#   optional   a default (shown) or empty applies

# ── Domains (generated: Coolify's domain of each service) ─────────────────
# Set each service's domain in Coolify (api, admin, web, centrifugo,
# livekit, media, minio); these follow it. A URL or a bare host is accepted.
SERVICE_URL_API=https://api.example.com
SERVICE_URL_ADMIN=https://admin.example.com
SERVICE_URL_WEB=https://example.com
SERVICE_URL_CENTRIFUGO=https://rt.example.com
SERVICE_URL_LIVEKIT=https://rtc.example.com
SERVICE_URL_MEDIA=https://cdn.example.com
SERVICE_URL_MINIO=https://s3.example.com
# App-links host when it is not the website's own host (optional; empty: the
# website's host). Add it to the web service's domains too.
PUBLIC_LINKS_URL=

# ── Generated secrets (Coolify) ───────────────────────────────────────────
# PostgreSQL superuser (initdb only; local maintenance uses the socket).
SERVICE_PASSWORD_POSTGRES=<generated>
# Login roles: schema owner (migrations), API, worker.
SERVICE_PASSWORD_PGOWNER=<generated>
SERVICE_PASSWORD_PGAPI=<generated>
SERVICE_PASSWORD_PGWORKER=<generated>
# Valkey instances: kv-core (queues, streams), kv-cache (LRU), kv-rt (realtime engine).
SERVICE_PASSWORD_KVCORE=<generated>
SERVICE_PASSWORD_KVCACHE=<generated>
SERVICE_PASSWORD_KVRT=<generated>
# Realtime: connection-token HMAC secret and server API key.
SERVICE_PASSWORD_64_CENTRIFUGOTOKEN=<generated>
SERVICE_PASSWORD_64_CENTRIFUGOAPI=<generated>
# Calls: LiveKit API key and secret, and the key of the opaque per-call
# identities (API and worker share it; never the LiveKit secret itself).
SERVICE_USER_LIVEKIT=<generated>
SERVICE_PASSWORD_64_LIVEKIT=<generated>
SERVICE_PASSWORD_64_LIVEKITID=<generated>
# Bundled object store: root account, the application's access key.
SERVICE_USER_MINIO=<generated>
SERVICE_PASSWORD_MINIO=<generated>
SERVICE_USER_S3APP=<generated>
SERVICE_PASSWORD_64_S3APP=<generated>
# Bundled media origin: link-signing key, and the secret it shows the store.
SERVICE_PASSWORD_64_MEDIASIGN=<generated>
SERVICE_PASSWORD_64_MEDIAORIGIN=<generated>
# Backup encryption passphrase. COPY IT OFF THE SERVER: backups are unreadable without it.
SERVICE_PASSWORD_64_BACKUP=<generated>

# ── Required, set once by hand (keep copies off the server) ───────────────
# The brand id (lowercase letters, digits, _ and -; not _template).
BRAND=<brand-id>
# base64 of the brand's brand.json (base64 -w0 brand.json). The repository holds only the template brand.
BRAND_JSON_BASE64=<base64 of brand.json>
# Feistel keys of public ids, 32 bytes base64url each (openssl rand 32 | basenc --base64url | tr -d '='). NEVER changed after launch.
ID_PUBLIC_KEY=<43 base64url characters>
ID_BILLING_KEY=<43 base64url characters, different>
# Keyed-hash peppers, a JSON key ring: {"1":"<32 bytes base64url>"}.
HASH_PEPPERS={"1":"<43 base64url characters>"}
# Sealing keys of phone numbers and secrets, a JSON key ring: {"1":"<32 bytes base64url>"}. Backups are unreadable without it.
DATA_KEYS={"1":"<43 base64url characters>"}
# Access-token signing pair, Ed25519 PEM (openssl genpkey -algorithm ed25519); line breaks as \n.
AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<base64>\n-----END PRIVATE KEY-----
AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----
# FCM service account (one Firebase project, both store builds): base64 -w0 of its JSON.
FCM_SERVICE_ACCOUNT_JSON=<base64 of the service account JSON>
# Signs the origins document (how apps find the servers after a move): an
# Ed25519 seed from `pnpm --filter @app/api origins:keygen` (or
# `node dist/scripts/origins-keygen.js` in the api container). Its public key,
# with ORIGINS_SIGNING_KID, goes into brand.json origins.publicKeys before the
# app is built. Keep a copy off the server; a new key needs a new app build
# that knows its public key (see the keygen's notes on rotation).
ORIGINS_SIGNING_KEY=<43 base64url characters from origins:keygen>

# ── Optional: keys and providers ──────────────────────────────────────────
# Key ids of the rings above that seal and hash new values.
HASH_PEPPER_KID=1
DATA_KEY_ID=1
# Access tokens: issuer claim, signing key id, and the previous key during a rotation.
AUTH_JWT_ISSUER=app-api
AUTH_JWT_KID=k1
AUTH_JWT_PREVIOUS_KID=
AUTH_JWT_PREVIOUS_PUBLIC_KEY=
# Overrides the FCM service account's project id.
FCM_PROJECT_ID=
# Google sign-in web client id (play build sign-in, website deletion page); empty: Google sign-in is off.
GOOGLE_WEB_CLIENT_ID=
# SMS providers for sign-in codes (app_config auth.sms_routing picks them per number prefix).
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_TEMPLATE=
SMS_SMSIR_API_KEY=
SMS_SMSIR_TEMPLATE_ID=
SMS_SMSIR_PARAMETER=CODE
SMS_TELNYX_API_KEY=
SMS_TELNYX_VERIFY_PROFILE_ID=

# ── Optional: store purchases ─────────────────────────────────────────────
# Empty: that store is not configured (its purchases answer 503
# store_unavailable; everything else runs). Google Play: the package and the
# service account JSON (base64) with access to orders and subscriptions;
# RTDN also needs the Pub/Sub push subscription's OIDC audience and its
# service account e-mail. Cafe Bazaar: the package, the app's RSA public key
# from Pishkhan and the Pishkhan API token (or the older OAuth client id,
# secret and refresh token, the three together).
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_PUSH_SA_EMAIL=
BAZAAR_PACKAGE_NAME=
BAZAAR_RSA_PUBLIC_KEY=
BAZAAR_PISHKHAN_API_TOKEN=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=

# ── The signed origins document (how apps find the servers after a move) ─
# The key is required (above). Its id in brand.json, and how long a signed
# document stays valid. The hosts are changed in the admin panel (Hosts).
ORIGINS_SIGNING_KID=o1
ORIGINS_TTL_DAYS=30
# Copies for apps that cannot reach the API: the media bucket
# (<cdn>/bootstrap/origins.json), and more places on other providers, a JSON
# array of {"kind":"s3",...} or {"kind":"put",...} targets (see
# server/apps/worker/.env.example; it holds credentials).
ORIGINS_PUBLISH_MEDIA=true
ORIGINS_PUBLISH_TARGETS=

# ── Optional: object storage and CDN ──────────────────────────────────────
# Empty S3_ENDPOINT: the bundled MinIO (its S3_* come from the generated values above;
# the servers reach it on the stack's network, phones through its public URL).
S3_ENDPOINT=
# The same store on an internal address for the servers' own traffic (empty: S3_ENDPOINT).
S3_INTERNAL_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
# Bucket names (also used by the bundled MinIO); they must differ.
S3_BUCKET_PRIVATE=uploads
S3_BUCKET_MEDIA=media
# Empty CDN_BASE_URL with the bundled store: the bundled media origin (hmac
# links, generated key). An external S3_ENDPOINT needs its own CDN_BASE_URL and
# CDN_SIGNING_KEY (the media origin reads the bundled store only).
CDN_BASE_URL=
CDN_SIGNING_KEY=
# hmac (an edge checks exp and sig) or bunny (Bunny token authentication).
CDN_SIGNING_SCHEME=hmac

# ── Optional: the admin panel's Persian font ──────────────────────────────
# A stylesheet with the @font-face rules of a licensed font, at a private URL
# (https, no query), and the family name it declares. Font files and the
# stylesheet stay out of the repository; the panel's CSP allows that origin.
# Empty: the panel uses the brand's Persian font name and the system fonts.
ADMIN_PERSIAN_FONT_CSS_URL=
ADMIN_PERSIAN_FONT_FAMILY=

# ── Optional: tuning ──────────────────────────────────────────────────────
LOG_LEVEL=info
# Proxy hops whose X-Forwarded-For the API believes (Coolify's proxy is one hop).
TRUST_PROXY=1
# Cloudflare edge ranges: empty = the published ranges, off = not behind Cloudflare.
CF_EDGE_TRUST=
# Serves /docs and the OpenAPI document.
OPENAPI_ENABLED=false
# After SIGTERM, /readyz answers 503 this long before the API stops accepting requests.
SHUTDOWN_DRAIN_MS=5000
# Key prefix in Valkey.
REDIS_KEY_PREFIX=app:
# Connection pools of each process (towards PgBouncer).
API_DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=10
# Jobs per queue and photos processed at once in the worker.
WORKER_CONCURRENCY=4
PHOTO_CONCURRENCY=2
# PgBouncer: server connections per (database, user), client cap, total server cap.
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_MAX_DB_CONNECTIONS=60
# PostgreSQL memory.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
# Read-only analyst login (app_analyst); empty: no analyst login.
PG_ANALYST_PASSWORD=
# lock_timeout of each migration file, in milliseconds.
MIGRATION_LOCK_TIMEOUT_MS=5000
# Valkey memory caps.
KV_CORE_MAXMEMORY=2gb
KV_CACHE_MAXMEMORY=1gb
KV_RT_MAXMEMORY=512mb
# Browser origins allowed to open realtime connections (comma-separated
# scheme://host[:port], no "*"); native apps send no Origin and need none.
CENTRIFUGO_ALLOWED_ORIGINS=
# LiveKit's public IPv4; empty (or auto): found at every start (an HTTP lookup
# by IP, then LiveKit's own STUN), so a server move needs only DNS.
LIVEKIT_NODE_IP=
# The in-country media relay (deploy/relay/) runs on a server of its own, not
# in this stack: its shared secret is saved in the admin panel's RTC settings
# (sealed, shown as a fingerprint), never here.
# Days between a deletion request and the purge, as the server's setting (website text).
DELETION_GRACE_DAYS=30

# ── Optional: backups (pg-backup in the postgres container) ───────────────
# Copies older than this are removed from the backups volume.
BACKUP_KEEP_DAYS=14
# Off-server copy: https://<endpoint>/<bucket>/<prefix>, with its keys and region.
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
