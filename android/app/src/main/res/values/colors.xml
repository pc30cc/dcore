<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window, the same colour as the templates' page (the `bg` token of
         `neon`, the default, and of `white`, ui/theme/Templates.kt), so the
         system splash hands over to the first frame without a flash. The
         brand colours (brand_primary, brand_gradient_start/end) are
         generated from brand.json by the build. -->
    <color name="launch_background">#0A090E</color>
    <color name="launch_background_light">#FFFFFF</color>
    <color name="launch_mark">#FFFFFF</color>
</resources>
