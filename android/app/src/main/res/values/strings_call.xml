<?xml version="1.0" encoding="utf-8"?>
<!--
  Calls: the call screen, the ring, the ongoing call, the call line in the
  chat and the call settings of a match. Kept in a file of their own so
  features built side by side do not edit the same file; every key is also in
  values-fa and values-tr.
-->
