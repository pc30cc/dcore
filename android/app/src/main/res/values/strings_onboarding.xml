    <string name="onboarding_rules_title">Our community guidelines</string>
    <string name="onboarding_rules_body">{appName} works when everyone feels safe and respected. By joining, you agree to:</string>
    <string name="onboarding_rule_real_title">Be yourself</string>
    <string name="onboarding_rule_real">Use your own photos, your real age and your real name. No fake profiles.</string>
    <string name="onboarding_rule_kind_title">Be kind</string>
    <string name="onboarding_rule_kind">Treat people with respect. No harassment, hate or threats.</string>
    <string name="onboarding_rule_consent_title">Respect consent</string>
    <string name="onboarding_rule_consent">Nothing explicit and no unwanted advances. No means no.</string>
    <string name="onboarding_rule_safe_title">Stay safe</string>
    <string name="onboarding_rule_safe">Never send money or share financial details. Report anything that worries you: reports are confidential.</string>
    <string name="onboarding_rule_adults_title">Adults only</string>
    <string name="onboarding_rule_adults">{appName} is for people aged 18 and over.</string>
    <string name="onboarding_rules_read_full">Read the full community guidelines</string>
