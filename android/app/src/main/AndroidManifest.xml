<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to its server. Without this every request fails as a
         transport error and the app looks offline on a working connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sign-up asks for these at their own step, each with its reason first.
         Approximate location only: the server keeps a cell of a few
         kilometres, never a position. Notifications: Android 13+ asks. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Calls between matched people (feature/call). The microphone, the camera
      and BLUETOOTH_CONNECT are asked for when a call is placed or answered,
      never at launch; Bluetooth is how a headset is offered for the call's
      sound on Android 12+. MODIFY_AUDIO_SETTINGS lets the call move between
      earpiece, speaker and headset.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- A ring takes the whole screen, as a phone call does; from Android 14
         the person can turn that off, and the ring is a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- A call in progress runs under a foreground service typed for what it
         uses (the microphone, and the camera while it is on), or Android
         silences the microphone once the app is behind another or the screen
         is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- The proximity sensor turns the screen off at the ear on a voice call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The media SDK's screen sharing, which the app never does: its service
         and permission are removed (below), so no store asks to justify them. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <!-- Not required: a phone without a camera can still take a voice call. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!--
      Shared by both stores. What only one store needs (its billing permission,
      its package in <queries>, its SDK's components) comes from that flavor's
      manifest (src/bazaar, src/play) or its SDK's, never from here.

      Backup is off and data_extraction_rules.xml excludes everything: the
      session is encrypted under a key that cannot leave the device.

      The per-app language list Android 13+ shows in system settings
      (android:localeConfig) is generated by the build from the res folders
      (androidResources.generateLocaleConfig).
    -->
    <application
        android:name=".CoreApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!--
          singleTop: a notification or link tapped while the app is open
          reaches this activity instead of stacking a second copy.
          adjustResize: the keyboard resizes the window, and Compose's IME
          insets do the rest.
          supportsPictureInPicture: a video call goes on in the system's small
          window when the person leaves for another app. configChanges: size,
          orientation and window-mode changes are handled by Compose, so turning
          the phone or entering that window never rebuilds a call's video.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Push (FCM, both store builds). Not exported: only Google Play
          services' own intent reaches it. Without Play services it never runs
          and the app gets everything over realtime while it is open.
        -->
        <service
            android:name=".push.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- What the system uses for a background notification the server did not fully describe. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_primary" />
        <!-- No token exists until someone signs in; the registrar turns it on. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!--
          Firebase is started by the app from the build's or the server's
          values (CoreApp), never from a google-services.json resource, so its
          own start-up provider has nothing to do.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- WorkManager starts when first asked (CoreApp is its Configuration.Provider), not at every launch. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Decline on a ring and End on a call, without opening the app. Not
             exported: only this app's own notifications send it. -->
        <receiver
            android:name=".push.CallActionReceiver"
            android:exported="false" />

        <!-- A call in progress: started from the call while the app is in
             front, stopped at its end. -->
        <service
            android:name=".feature.call.OngoingCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- The media SDK's screen-share service: see the permission above. -->
        <service
            android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            tools:node="remove" />
    </application>
</manifest>
