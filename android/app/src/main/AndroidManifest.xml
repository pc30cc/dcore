<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to its server. Without this every request fails as a
         transport error and the app looks offline on a working connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sign-up asks for these at their own step, each with its reason first.
         Approximate location only: the server keeps a cell of a few
         kilometres, never a position. Notifications: Android 13+ asks. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Shared by both stores. What only one store needs (its billing permission,
      its package in <queries>, its SDK's components) comes from that flavor's
      manifest (src/bazaar, src/play) or its SDK's, never from here.

      Backup is off and data_extraction_rules.xml excludes everything: the
      session is encrypted under a key that cannot leave the device.

      The per-app language list Android 13+ shows in system settings
      (android:localeConfig) is generated by the build from the res folders
      (androidResources.generateLocaleConfig).
    -->
    <application
        android:name=".CoreApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!--
          singleTop: a notification or link tapped while the app is open
          reaches this activity instead of stacking a second copy.
          adjustResize: the keyboard resizes the window, and Compose's IME
          insets do the rest.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
