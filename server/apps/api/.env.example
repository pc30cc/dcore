# API configuration. Copy to .env for local runs (never commit .env).
# Secrets have no defaults: the process refuses to start without them.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Human-readable logs in a terminal; must stay off in production.
LOG_PRETTY=true

# PostgreSQL. DATABASE_TARGET=pgbouncer when the URL points at PgBouncer in
# transaction mode (then the timeouts below come from the role or PgBouncer).
DATABASE_URL=postgres://app:app@127.0.0.1:54317/app_dev
DATABASE_TARGET=postgres
DATABASE_APPLICATION_NAME=api
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=3000

# Redis or Valkey.
REDIS_URL=redis://127.0.0.1:63790/0
REDIS_KEY_PREFIX=app:
# kv-cache: a second instance with maxmemory-policy allkeys-lru for what may
# be evicted and rebuilt (own-account views, cards, deck queues, entitlements,
# presence). Unset: REDIS_URL (one instance in development). See
# infra/valkey/ for the settings of each instance.
# REDIS_CACHE_URL=redis://127.0.0.1:63791/0

# Hops or comma-separated CIDRs of the proxies in front of the API whose
# X-Forwarded-For is believed. false: none (the API is reached directly).
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576

# The admin panel's exact origins (comma-separated). Nothing else gets CORS.
CORS_ADMIN_ORIGINS=http://localhost:5173

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

OPENAPI_ENABLED=true

READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=1000
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000

# Access tokens. EdDSA (Ed25519) in production; generate a pair with:
#   openssl genpkey -algorithm ed25519 -out access-private.pem
#   openssl pkey -in access-private.pem -pubout -out access-public.pem
# and put the PEM in the variables (literal \n line breaks are accepted).
AUTH_JWT_ALG=EdDSA
AUTH_JWT_ISSUER=https://api.example.com
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_JWT_KID=k1
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# HS256 instead (one service signs and verifies): 32+ random bytes, base64url:
#   openssl rand 32 | basenc --base64url | tr -d '='
# AUTH_JWT_ALG=HS256
# AUTH_JWT_SECRET=
# During a key rotation, the previous key keeps verifying (never signing):
# AUTH_JWT_PREVIOUS_KID=
# AUTH_JWT_PREVIOUS_PUBLIC_KEY=
# AUTH_JWT_PREVIOUS_SECRET=

# Public ids. Two different random 32-byte keys, base64url (43 characters):
#   openssl rand 32 | basenc --base64url | tr -d '='
# NEVER change them after launch: every public user id and billing reference
# is derived from them and none is stored.
ID_PUBLIC_KEY=
ID_BILLING_KEY=
# Keyed hashes (phones, Google accounts, device keys) and sealed values
# (phone numbers, TOTP and provider secrets): JSON objects of key id to a
# 32-byte base64url key. Add a key under a new id and point the *_KID / *_ID
# at it; keep the old ones while values made with them exist. Keep a copy of
# DATA_KEYS somewhere other than the database host: backups are unreadable
# without it.
HASH_PEPPERS=
HASH_PEPPER_KID=1
DATA_KEYS=
DATA_KEY_ID=1

# Which proxies are Cloudflare's edge (their cf-connecting-ip is believed):
# empty for Cloudflare's published ranges, `off` when nothing is in front,
# a comma-separated list (`default` stands for the published ranges), or
# file:/path/to/ranges (one address or CIDR per line).
CF_EDGE_TRUST=

# PostgreSQL statement budgets per route: off (production), count (adds an
# x-pg-statements response header), enforce (tests: a route over its budget
# fails). Default: enforce under NODE_ENV=test, else off.
# PG_BUDGET=count

# Google sign-in (play build only): the OAuth web client id ID tokens must be
# issued for. Unset: the Google routes answer 503.
# GOOGLE_WEB_CLIENT_ID=

# SMS providers for sign-in codes. app_config `auth.sms_routing` picks them
# per number prefix, in order; a provider without its key is skipped. The
# templates (the text, the app's name, the SMS Retriever hash of the play
# build) live in each provider's panel; requests carry the code only.
# SMS_KAVENEGAR_API_KEY=
# SMS_KAVENEGAR_TEMPLATE=
# SMS_SMSIR_API_KEY=
# SMS_SMSIR_TEMPLATE_ID=
# SMS_SMSIR_PARAMETER=CODE
# SMS_TELNYX_API_KEY=
# SMS_TELNYX_VERIFY_PROFILE_ID=
# SMS_TIMEOUT_MS=5000
# The fake provider, never in production: log (development default: the
# code goes to the log), memory (tests), off.
# SMS_FAKE=log

# The brand served (brands/<id>/brand.json: name, colours, legal links,
# domains); the template is refused in production. BRANDS_DIR when the
# brands folder is not above the working directory.
BRAND=_template
# BRANDS_DIR=

# Realtime connection tokens (POST /v1/realtime/token): the HMAC secret
# Centrifugo verifies them with (required in production; unset elsewhere the
# route answers 503), the WebSocket URL apps connect to (default
# wss://<domains.realtime>/connection/websocket) and their lifetime.
# CENTRIFUGO_TOKEN_HMAC_SECRET=
# CENTRIFUGO_WS_URL=
# REALTIME_TOKEN_TTL_SECONDS=3600
# Centrifugo's server API, for the events the API publishes itself (a like
# to its target, an ended conversation to both people); both together,
# required in production. Unset elsewhere: those events are not published.
# CENTRIFUGO_API_URL=http://localhost:8001  (infra/docker-compose.yml maps the server API port there)
# CENTRIFUGO_API_KEY=
# Replicas a chat send waits for after its stream append (WAIT n, at most WRITE_BEHIND_WAIT_MS); 0 without a replica.
# WRITE_BEHIND_WAIT_REPLICAS=0
# WRITE_BEHIND_WAIT_MS=50

# Photo storage (S3-compatible) and the CDN in front of the media bucket.
# The S3 variables come together; without them the photo routes answer 503.
# Both are required in production. The private bucket holds uploads only
# (u/<photoId>) and is never public; give it a lifecycle rule that deletes
# u/ objects older than a day. The media bucket holds the stripped variants
# (p/<photoId>/<blobVer>/<size>.webp) behind the CDN. CDN_SIGNING_SCHEME:
# hmac (an edge function checks exp and sig) or bunny (token authentication).
# S3_ENDPOINT is the store's public address (presigned uploads name it);
# S3_INTERNAL_ENDPOINT, when set, is the same store on the internal network
# (http://minio:9000), used for the server's own reads, writes and deletes.
# S3_ENDPOINT=
# S3_INTERNAL_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET_PRIVATE=
# S3_BUCKET_MEDIA=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true
# S3_TIMEOUT_MS=10000
# CDN_BASE_URL=
# CDN_SIGNING_KEY=
# CDN_SIGNING_SCHEME=hmac

# Account deletion on the website (no sign-in). SITE_ORIGIN is where the
# deletion forms are sent back to (303) and the only origin CORS allows on
# those routes; unset, it is https://<the brand's domains.legal>. The Google
# route verifies ID tokens for GOOGLE_WEB_CLIENT_ID.
# SITE_ORIGIN=https://example.com

# Calls. LiveKit's server API is reached directly (CreateRoom when a call is
# answered, DeleteRoom after its end, the room check); the four come
# together, and without them the call routes answer 503. The identity secret
# keys the opaque per-call identities (u:<16 hex>) and must be the worker's
# too. The clients' signalling URL, the in-country TURN relay (its URLs,
# shared secret, countries and credential lifetime) and the live cap are the
# admin panel's RTC settings (app_config providers.rtc), never set here.
# LIVEKIT_API_URL=http://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_IDENTITY_SECRET=

# The signed origins document (GET /v1/origins, and the copies the worker
# publishes): where apps find the API, realtime, calls, the CDN and the
# website without a new build. ORIGINS_SIGNING_KEY is an Ed25519 seed (32
# bytes, base64url) made by `pnpm --filter @app/api origins:keygen`; its
# public key and ORIGINS_SIGNING_KID go into brand.json origins.publicKeys.
# Unset: GET /v1/origins answers 503 and apps keep the hosts they were built
# with. The hosts themselves are the admin panel's (app_config
# origins.hosts); until it saves some, the document carries this
# deployment's own (brand.json domains, CENTRIFUGO_WS_URL, CDN_BASE_URL,
# SITE_ORIGIN).
# ORIGINS_SIGNING_KEY=
ORIGINS_SIGNING_KID=o1
ORIGINS_TTL_DAYS=30
