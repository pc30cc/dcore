# API configuration. Copy to .env for local runs (never commit .env).
# Secrets have no defaults: the process refuses to start without them.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Human-readable logs in a terminal; must stay off in production.
LOG_PRETTY=true

# PostgreSQL. DATABASE_TARGET=pgbouncer when the URL points at PgBouncer in
# transaction mode (then the timeouts below come from the role or PgBouncer).
DATABASE_URL=postgres://app:app@127.0.0.1:54317/app_dev
DATABASE_TARGET=postgres
DATABASE_APPLICATION_NAME=api
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=3000

# Redis or Valkey.
REDIS_URL=redis://127.0.0.1:63790/0
REDIS_KEY_PREFIX=app:

# Hops or comma-separated CIDRs of the proxies in front of the API whose
# X-Forwarded-For is believed. false: none (the API is reached directly).
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576

# The admin panel's exact origins (comma-separated). Nothing else gets CORS.
CORS_ADMIN_ORIGINS=http://localhost:5173

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

OPENAPI_ENABLED=true

READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=1000
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=15000

# Access tokens. EdDSA (Ed25519) in production; generate a pair with:
#   openssl genpkey -algorithm ed25519 -out access-private.pem
#   openssl pkey -in access-private.pem -pubout -out access-public.pem
# and put the PEM in the variables (literal \n line breaks are accepted).
AUTH_JWT_ALG=EdDSA
AUTH_JWT_ISSUER=https://api.example.com
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_JWT_KID=k1
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# HS256 instead (one service signs and verifies): 32+ random bytes, base64url:
#   openssl rand 32 | basenc --base64url | tr -d '='
# AUTH_JWT_ALG=HS256
# AUTH_JWT_SECRET=
# During a key rotation, the previous key keeps verifying (never signing):
# AUTH_JWT_PREVIOUS_KID=
# AUTH_JWT_PREVIOUS_PUBLIC_KEY=
# AUTH_JWT_PREVIOUS_SECRET=
