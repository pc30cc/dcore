{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "The HTTP API (Fastify 5).",
  "type": "module",
  "exports": {
    ".": {
      "@app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --conditions=@app/source src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsx --conditions=@app/source src/scripts/print-openapi.ts",
    "origins:keygen": "tsx --conditions=@app/source src/scripts/origins-keygen.ts",
    "admin:create": "tsx --conditions=@app/source src/scripts/admin-create.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "bullmq": "^6.5.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@app/worker": "workspace:*",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "yaml": "2.9.1"
  }
}
