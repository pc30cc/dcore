---
import type { GetStaticPaths } from 'astro';
import type { Locale } from '@app/shared';
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import { sitePages } from '../../content/pages';
import { ui } from '../../content/ui';
import { brand } from '../../lib/brand';
import { documentSlugs, fill, type DocumentSlug } from '../../lib/i18n';

export const getStaticPaths = (() =>
  brand.locales.flatMap((locale) => documentSlugs.map((page) => ({ params: { locale, page } })))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const slug = Astro.params.page as DocumentSlug;
const page = sitePages[slug];
const content = page.content[locale];
const strings = ui[locale];
---
<Base locale={locale} page={slug} title={content.title} description={content.description}>
  <article class="document">
    <h1>{fill(locale, content.title)}</h1>
    <p class="lead">{fill(locale, content.description)}</p>
    {page.draft && (
      <aside class="notice" role="note">
        <strong>{strings.draftTitle}</strong>
        <p>{fill(locale, strings.draftBody)}</p>
      </aside>
    )}
    <Sections locale={locale} sections={content.sections} />
  </article>
</Base>
