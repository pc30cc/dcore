---
import type { GetStaticPaths } from 'astro';
import type { Locale } from '@app/shared';
import Base from '../../layouts/Base.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { ui } from '../../content/ui';
import { brand, brandConfig, brandCopy } from '../../lib/brand';
import { fill, footerPageIds, pagePath } from '../../lib/i18n';
import { screenshots } from '../../lib/media';

export const getStaticPaths = (() => brand.locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const strings = ui[locale];
// What the app is and offers is the brand's copy, never written in code.
const tagline = brandCopy(brand.tagline, locale);
const description = brandCopy(brand.description, locale);
const highlights = (brandConfig.site?.highlights ?? [])
  .map((item) => ({ title: brandCopy(item.title, locale), body: brandCopy(item.body, locale) }))
  .filter((item) => item.title !== '');
const shots = screenshots(locale);
---
<Base locale={locale} page="" title={brand.appName} description={description || tagline}>
  <section class="hero">
    <h1>{brand.appName}</h1>
    {tagline && <p class="lead">{fill(locale, tagline)}</p>}
    {description && <p>{fill(locale, description)}</p>}
  </section>
  <section class="panel" aria-labelledby="stores-title">
    <h2 id="stores-title">{strings.homeStoresTitle}</h2>
    <StoreButtons locale={locale} soon={strings.homeStoresSoon} />
    <p><a href={pagePath(locale, 'download')}>{strings.homeDownloadLink}</a></p>
  </section>
  {highlights.length > 0 && (
    <section aria-labelledby="highlights-title">
      <h2 id="highlights-title">{strings.homeHighlightsTitle}</h2>
      <ul class="highlights">
        {highlights.map((item) => (
          <li>
            <h3>{fill(locale, item.title)}</h3>
            {item.body && <p>{fill(locale, item.body)}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}
  {shots.length > 0 && (
    <section aria-labelledby="screenshots-title">
      <h2 id="screenshots-title">{strings.homeScreenshotsTitle}</h2>
      <ul class="screenshots">
        {shots.map((shot) => (
          <li><img src={shot.src} alt={fill(locale, shot.alt)} width={shot.width} height={shot.height} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </section>
  )}
  <section aria-labelledby="safety-title">
    <h2 id="safety-title">{strings.homeSafetyTitle}</h2>
    <ul class="checks">
      {strings.homeSafety.map((item) => <li>{fill(locale, item)}</li>)}
    </ul>
  </section>
  <section aria-labelledby="policies-title">
    <h2 id="policies-title">{strings.homePoliciesTitle}</h2>
    <ul class="cards">
      {footerPageIds.map((id) => (
        <li><a class="card" href={pagePath(locale, id)}>{strings.pageNames[id]}</a></li>
      ))}
    </ul>
  </section>
</Base>
