---
import type { GetStaticPaths } from 'astro';
import Redirect from '../components/Redirect.astro';
import { unlocalizedRedirects } from '../lib/routes';

export const getStaticPaths = (() =>
  unlocalizedRedirects().map(({ path, slug }) => ({ params: { redirect: path }, props: { slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.props;
---
<Redirect slug={slug} />
