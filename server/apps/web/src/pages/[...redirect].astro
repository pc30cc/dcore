---
import type { GetStaticPaths } from 'astro';
import Redirect from '../components/Redirect.astro';
import { unlocalizedRedirects } from '../lib/routes';

export const getStaticPaths = (() =>
  unlocalizedRedirects().map(({ path, id }) => ({ params: { redirect: path }, props: { id } }))) satisfies GetStaticPaths;

const { id } = Astro.props;
---
<Redirect page={id} />
