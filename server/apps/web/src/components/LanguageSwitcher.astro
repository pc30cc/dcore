---
import type { Locale } from '@app/shared';
import { brand } from '../lib/brand';
import { pagePath, type PageId } from '../lib/i18n';
import { ui } from '../content/ui';

interface Props {
  locale: Locale;
  /** The page in the other languages; the 404 page offers Support, which the apps may show. */
  page?: PageId | undefined;
}

const { locale, page } = Astro.props;
const target: PageId = page ?? 'support';
const names: Record<Locale, string> = { en: 'English', fa: 'فارسی', tr: 'Türkçe' };
---
{brand.locales.length > 1 && (
  <nav class="languages" aria-label={ui[locale].languageLabel}>
    <ul>
      {brand.locales.map((code) => (
        <li>
          <a href={pagePath(code, target)} lang={code} hreflang={code} aria-current={code === locale ? 'true' : undefined}>
            {names[code]}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
