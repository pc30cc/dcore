---
import type { Locale } from '@app/shared';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { ui } from '../content/ui';
import { brand, siteOrigin } from '../lib/brand';
import { contentSecurityPolicy } from '../lib/csp';
import { dir, fill, footerPageIds, isAppFacing, pagePath, type PageId } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** The page; none for the 404 page. */
  page?: PageId | undefined;
  title: string;
  description: string;
  /** For pages that must not be indexed (404, the steps of the deletion flow). */
  noindex?: boolean | undefined;
  /** The exact text of each inline script the page has (for the Content-Security-Policy). */
  inlineScripts?: readonly string[] | undefined;
  /** Where the page's forms post. */
  formAction?: readonly string[] | undefined;
  /** The page loads Google Identity Services. */
  google?: boolean | undefined;
}

const { locale, page, title, description, noindex = false, inlineScripts, formAction, google } = Astro.props;
const strings = ui[locale];
// The pages the apps open (and the 404) never link the landing or the download page.
const appFacing = page === undefined || isAppFacing(page);
const pageTitle = page === '' ? brand.appName : `${fill(locale, title)} · ${brand.appName}`;
const canonical = `${siteOrigin}${pagePath(locale, page)}`;
const csp = contentSecurityPolicy({ inlineScripts, formAction, google });
const brandStyle = [
  `--brand-light:${brand.colors.brand.light}`,
  `--brand-dark:${brand.colors.brand.dark}`,
  `--on-brand-light:${brand.colors.onBrand.light}`,
  `--on-brand-dark:${brand.colors.onBrand.dark}`,
  `--font-latin:${JSON.stringify(brand.fonts.latin)}`,
  `--font-persian:${JSON.stringify(brand.fonts.persian)}`,
].join(';');
const footerPages = appFacing ? footerPageIds : (['download', ...footerPageIds] as const);
---
<!doctype html>
<html lang={locale} dir={dir(locale)} style={brandStyle}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.MODE !== 'development' && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={brand.colors.brand.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={brand.colors.brand.dark} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={fill(locale, description)} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {brand.locales.map((code) => <link rel="alternate" hreflang={code} href={`${siteOrigin}${pagePath(code, page)}`} />)}
        <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${pagePath(brand.defaultLocale, page)}`} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.appName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={fill(locale, description)} />
    {page !== undefined && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale} />
  </head>
  <body>
    <a class="skip" href="#main">{strings.skipToContent}</a>
    <header class="site-header">
      <div class="container header-row">
        {appFacing ? (
          <span class="wordmark">{brand.appName}</span>
        ) : (
          <a class="wordmark" href={pagePath(locale)}>{brand.appName}</a>
        )}
        {!appFacing && (
          <nav class="main-nav" aria-label={strings.mainNavLabel}>
            <ul>
              <li>
                <a href={pagePath(locale, 'download')} aria-current={page === 'download' ? 'page' : undefined}>
                  {strings.pageNames.download}
                </a>
              </li>
            </ul>
          </nav>
        )}
        <LanguageSwitcher locale={locale} page={page} />
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <nav aria-label={strings.footerPolicies}>
          <h2>{strings.footerPolicies}</h2>
          <ul>
            {footerPages.map((id) => (
              <li><a href={pagePath(locale, id)} aria-current={id === page ? 'page' : undefined}>{strings.pageNames[id]}</a></li>
            ))}
          </ul>
        </nav>
        <div>
          <h2>{strings.footerContact}</h2>
          <p><a href={`mailto:${brand.legal.supportEmail}`} dir="ltr">{brand.legal.supportEmail}</a></p>
        </div>
      </div>
      <p class="container copyright">© {new Date().getFullYear()} {brand.appName}</p>
    </footer>
  </body>
</html>
