# Website build settings. Read while building (`pnpm build`); nothing here
# reaches a browser except what the pages show. Copy to .env for local runs,
# or set them in the build's environment (which wins over .env).

# The brand to build for: brands/<id>/brand.json (default: the template).
# BRAND and BRANDS_DIR are read from the environment only, not from .env.
# BRAND=_template
# BRANDS_DIR=../../../brands

# Where the deletion forms post (an origin, no path). Default: https://<domains.api>.
# Plain http is accepted only for localhost.
# PUBLIC_API_ORIGIN=http://localhost:8080

# Google web client id for "signed in with Google" on the deletion page.
# Default: android.googleWebClientId in brand.json; empty means no Google button.
# PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Days between a deletion request and the purge, as the server's setting has it.
# PUBLIC_DELETION_GRACE_DAYS=30
