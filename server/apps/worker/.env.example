# Worker configuration. Copy to .env for local runs (never commit .env).
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Redis or Valkey; BullMQ needs maxmemory-policy noeviction on the server.
REDIS_URL=redis://127.0.0.1:63790/0
REDIS_KEY_PREFIX=app:

# Stable per process (consumer names in Redis Streams); defaults to <host>-<pid>.
# WORKER_ID=worker-1
WORKER_CONCURRENCY=4
SHUTDOWN_TIMEOUT_MS=30000
