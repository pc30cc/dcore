# Worker configuration. Copy to .env for local runs (never commit .env).
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Redis or Valkey; BullMQ needs maxmemory-policy noeviction on the server.
REDIS_URL=redis://127.0.0.1:63790/0
REDIS_KEY_PREFIX=app:
# kv-cache: a second instance with maxmemory-policy allkeys-lru for what may
# be evicted and rebuilt (own-account views, cards, deck queues, entitlements,
# presence). Unset: REDIS_URL (one instance in development). See
# infra/valkey/ for the settings of each instance.
# REDIS_CACHE_URL=redis://127.0.0.1:63791/0

# Stable per process (consumer names in Redis Streams); defaults to <host>-<pid>.
# WORKER_ID=worker-1
WORKER_CONCURRENCY=4
SHUTDOWN_TIMEOUT_MS=30000

# PostgreSQL, as the worker's login role (member of app_rw and app_maint:
# partition maintenance is EXECUTE for app_maint only). Jobs get longer
# statement timeouts than requests; the role's own settings still apply.
DATABASE_URL=postgres://app:app@127.0.0.1:54317/app_dev
DATABASE_TARGET=postgres
DATABASE_APPLICATION_NAME=worker
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=3000

# The API's Feistel keys (realtime channels are named by the public user id).
# 32 bytes base64url each, never changed after launch:
#   openssl rand 32 | basenc --base64url | tr -d '='
ID_PUBLIC_KEY=
ID_BILLING_KEY=

# Centrifugo's server API (publishing events to users); required in production.
# CENTRIFUGO_API_URL=http://127.0.0.1:8000
# CENTRIFUGO_API_KEY=

# Photo storage, as in the API's .env.example (S3_* and CDN_*). Without it the
# photo jobs wait and retry every minute.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET_PRIVATE=
# S3_BUCKET_MEDIA=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true
# S3_TIMEOUT_MS=10000
# CDN_BASE_URL=
# CDN_SIGNING_KEY=
# CDN_SIGNING_SCHEME=hmac

# Automatic photo moderation: `fake` until a provider is chosen. The fake
# sends every photo to a human unless PHOTO_AUTO_APPROVE=true (development
# default; refused in production).
MODERATION_PROVIDER=fake
# PHOTO_AUTO_APPROVE=true
PHOTO_CONCURRENCY=2
PHOTO_MAX_PIXELS=50000000

# The periodic maintenance jobs (partitions, active drain, sessions clean-up).
MAINT_ENABLED=true
