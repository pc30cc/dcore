# Passwords for infra/docker-compose.yml. Copy to infra/.env (git-ignored)
# and replace every value; these are for a development machine only.
POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
CENTRIFUGO_TOKEN_SECRET=change-me-centrifugo-token-secret-32-bytes-min
CENTRIFUGO_API_KEY=change-me-centrifugo-api-key
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret-32-characters-min
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=media
